	}
}

// process afs ads
function process_afs_ads(afd_response) {
	var num_top_ads = 0;
	if(afd_response.ads && afd_response.ads.length > 0) {
		num_top_ads = disp_afs_ads($(afs_top_ads_id), 
					 				$(afs_bot_ads_id), 
					 				afd_response.ads);	
					 
		disp_ws_results($(ws_results_id), num_top_ads);
	}
}


