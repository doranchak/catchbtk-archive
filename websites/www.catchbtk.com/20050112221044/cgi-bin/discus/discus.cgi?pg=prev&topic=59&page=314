<!--p:--><tr bgcolor="#cccccc"><td valign=top width=200><a name="POST3305"><font face="Verdana" size="1"><b><!--email--><!--/email--><!--name-->dawg<!--/name--></b></a><br><!--field:posts--><!--/field--><!--field:registered--><!--/field--><!--field:ip_address--><!--/field--></font></font></td><td valign=top><font face="Verdana" size="1"><table width=100% border=0 cellspacing=0 cellpadding=0><tr><td align=left><font face="Verdana" size="1">Posted on Monday, January 03, 2005 - 9:42 am: &nbsp;&nbsp;</font></td><td align=right></td></tr></table><hr noshade size=0><!--Text-->Time to get this straight....440 is a frequency band &#40;mhz&#41; used for shortwave/ham radio folks<!--/Text--></td></tr>
