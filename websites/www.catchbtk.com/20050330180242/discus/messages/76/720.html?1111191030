<!--p:--><tr bgcolor="#cccccc"><td valign=top width=200><a name="POST12215"><font face="Verdana" size="1"><b><!--email--><!--/email--><!--name-->Megabyte<!--/name--></b></a><br>Username: <!--field:uname-->Megabyte<!--/field--><br><br>Registered: <!--field:registered-->3-2005<!--/field--><br><!--field:ip_address--><!--/field--></font></font></td><td valign=top><font face="Verdana" size="1"><table width=100% border=0 cellspacing=0 cellpadding=0><tr><td align=left><font face="Verdana" size="1">Posted on Friday, March 25, 2005 - 12:50 pm: &nbsp;&nbsp;</font></td><td align=right></td></tr></table><hr noshade size=0><!--Text-->Here is a link to the books cover: <a href="http://photos1.blogger.com/blogger/373/898/0/nightmareinwichita-715203.jpg" target=_top>http://photos1.blogger.com/blogger/373/898/0/night mareinwichita-715203.jpg</a> .<!--/Text--></td></tr>
