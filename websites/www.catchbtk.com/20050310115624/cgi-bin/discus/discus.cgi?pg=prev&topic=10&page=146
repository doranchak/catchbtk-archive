<!--Post: 4753--><!--Time: 1106713095-->
<!--p:--><tr bgcolor="#f7f7f7"><td valign=top width=200><a name="POST4753"><font face="Verdana" size="1"><b><!--email--><!--/email--><!--name-->Jrl<!--/name--></b></a><br>Username: <!--field:uname-->Jrl<!--/field--><br><br>Registered: <!--field:registered-->1-2005<!--/field--><br><!--field:ip_address--><!--/field--></font></font></td><td valign=top><font face="Verdana" size="1"><table width=100% border=0 cellspacing=0 cellpadding=0><tr><td align=left><font face="Verdana" size="1">Posted on Tuesday, January 25, 2005 - 8:18 pm: &nbsp;&nbsp;</font></td><td align=right></td></tr></table><hr noshade size=0><!--Text-->Of note: <BR> <BR>He abbreviates diameter as dia.   <BR> <BR>For Joseph Junior he used a T-shirt, a plastic bag, and then another T-shirt over his head.<!--/Text--></td></tr>
