<!--Post: 4843--><!--Time: 1106769895-->
<!--p:--><tr bgcolor="#f7f7f7"><td valign=top width=200><a name="POST4843"><font face="Verdana" size="1"><b><!--email--><!--/email--><!--name-->Foxtrotnem<!--/name--></b></a><br>Username: <!--field:uname-->Foxtrotnem<!--/field--><br><br>Registered: <!--field:registered-->10-2004<!--/field--><br><!--field:ip_address--><!--/field--></font></font></td><td valign=top><font face="Verdana" size="1"><table width=100% border=0 cellspacing=0 cellpadding=0><tr><td align=left><font face="Verdana" size="1">Posted on Wednesday, January 26, 2005 - 12:04 pm: &nbsp;&nbsp;</font></td><td align=right></td></tr></table><hr noshade size=0><!--Text-->what freaks me about the letter is what he said about the car being dirty. marine hedges car was washed and parked some place other than her house and delores davis&#39; car was washed and cleaned and parked back at her house.<!--/Text--></td></tr>
