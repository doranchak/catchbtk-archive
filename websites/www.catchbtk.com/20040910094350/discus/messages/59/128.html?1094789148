<!--p:--><tr bgcolor="#f7f7f7"><td valign=top width=200><a name="POST958"><font face="Verdana" size="1"><b><!--email--><!--/email--><!--name-->Nick<!--/name--></b></a><br><!--field:posts--><!--/field--><!--field:registered--><!--/field--><!--field:ip_address--><!--/field--></font></font></td><td valign=top><font face="Verdana" size="1"><table width=100% border=0 cellspacing=0 cellpadding=0><tr><td align=left><font face="Verdana" size="1">Posted on Wednesday, September 01, 2004 - 2:12 am: &nbsp;&nbsp;</font></td><td align=right></td></tr></table><hr noshade size=0><!--Text-->See you in Hell son, and soon.<!--/Text--></td></tr>
