<!--p:--><tr bgcolor="#cccccc"><td valign=top width=200><a name="POST3954"><font face="Verdana" size="1"><b><!--email--><!--/email--><!--name-->Nugzter<!--/name--></b></a><br>Username: <!--field:uname-->Nugzter<!--/field--><br><br>Registered: <!--field:registered-->12-2004<!--/field--><br><!--field:ip_address--><!--/field--></font></font></td><td valign=top><font face="Verdana" size="1"><table width=100% border=0 cellspacing=0 cellpadding=0><tr><td align=left><font face="Verdana" size="1">Posted on Tuesday, January 11, 2005 - 5:31 am: &nbsp;&nbsp;</font></td><td align=right></td></tr></table><hr noshade size=0><!--Text-->That was fast here is the link <BR><a href="http://www.kansas.com/mld/kansas/10235499.htm" target=_top>http://www.kansas.com/mld/kansas/10235499.htm</a><!--/Text--></td></tr>
