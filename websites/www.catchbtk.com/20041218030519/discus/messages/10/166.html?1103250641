<!--p:--><tr bgcolor="#cccccc"><td valign=top width=200><a name="POST1345"><font face="Verdana" size="1"><b><!--email--><!--/email--><!--name-->Sean<!--/name--></b></a><br>Username: <!--field:uname-->Sean<!--/field--><br><br>Registered: <!--field:registered-->5-2004<!--/field--><br><!--field:ip_address--><!--/field--></font></font></td><td valign=top><font face="Verdana" size="1"><table width=100% border=0 cellspacing=0 cellpadding=0><tr><td align=left><font face="Verdana" size="1">Posted on Wednesday, November 03, 2004 - 10:22 am: &nbsp;&nbsp;</font></td><td align=right></td></tr></table><hr noshade size=0><!--Text--><a href="http://www.bellaonline.com/articles/art24023.asp" target=_top>http://www.bellaonline.com/articles/art24023.asp</a><!--/Text--></td></tr>
