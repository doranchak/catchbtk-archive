if (document.cookie.substring(i,j) == lookfor) {
var endstr = document.cookie.indexOf(";", j)
if (endstr == -1) {
endstr = document.cookie.length
}
return unescape(document.cookie.substring(j, endstr))
}
i = document.cookie.indexOf(" ", i) + 1
if (i == 0) {
break
