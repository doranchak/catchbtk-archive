<!--p:--><tr bgcolor="#cccccc"><td valign=top width=200><a name="POST1247"><font face="Verdana" size="1"><b><!--email--><!--/email--><!--name-->Colette<!--/name--></b></a><br>Username: <!--field:uname-->Colette<!--/field--><br><br>Registered: <!--field:registered-->6-2004<!--/field--><br><!--field:ip_address--><!--/field--></font></font></td><td valign=top><font face="Verdana" size="1"><table width=100% border=0 cellspacing=0 cellpadding=0><tr><td align=left><font face="Verdana" size="1">Posted on Friday, October 15, 2004 - 8:47 pm: &nbsp;&nbsp;</font></td><td align=right></td></tr></table><hr noshade size=0><!--Text-->sorry.. pair &#34;OF&#34; boxing gloves held up by laces..<!--/Text--></td></tr>
