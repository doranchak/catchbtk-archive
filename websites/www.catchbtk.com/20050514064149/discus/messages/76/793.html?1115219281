<!--p:--><tr bgcolor="#f7f7f7"><td valign=top width=200><a name="POST13311"><font face="Verdana" size="1"><b><!--email--><!--/email--><!--name-->Screamer<!--/name--></b></a><br>Username: <!--field:uname-->Screamer<!--/field--><br><br>Registered: <!--field:registered-->6-2004<!--/field--><br><!--field:ip_address--><!--/field--></font></font></td><td valign=top><font face="Verdana" size="1"><table width=100% border=0 cellspacing=0 cellpadding=0><tr><td align=left><font face="Verdana" size="1">Posted on Saturday, April 30, 2005 - 10:11 am: &nbsp;&nbsp;</font></td><td align=right></td></tr></table><hr noshade size=0><!--Text--><a href="http://www.kansas.com/mld/kansas/11529657.htm" target=_top>http://www.kansas.com/mld/kansas/11529657.htm</a><!--/Text--></td></tr>
