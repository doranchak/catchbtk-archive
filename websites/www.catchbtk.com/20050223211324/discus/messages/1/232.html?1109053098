<!--p:--><tr bgcolor="#f7f7f7"><td valign=top width=200><a name="POST2958"><font face="Verdana" size="1"><b><!--email--><a href="mailto:dammitslicky@cox.net" target="_blank"><!--/email--><!--name-->Cougar<!--/name--></b></a>
</a><br>Username: <!--field:uname-->Cougar<!--/field--><br><br>Registered: <!--field:registered-->10-2004<!--/field--><br><!--field:ip_address--><!--/field--></font></font></td><td valign=top><font face="Verdana" size="1"><table width=100% border=0 cellspacing=0 cellpadding=0><tr><td align=left><font face="Verdana" size="1">Posted on Wednesday, December 29, 2004 - 8:57 am: &nbsp;&nbsp;</font></td><td align=right></td></tr></table><hr noshade size=0><!--Text-->&#42;ROARING APPLAUSE&#42; Excellent work!  <BR> <BR>Off to see 410 North Market...........<!--/Text--></td></tr>
