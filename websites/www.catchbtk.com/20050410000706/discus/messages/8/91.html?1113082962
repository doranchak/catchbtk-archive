<!--Post: 8482--><!--Time: 1109174023-->
<!--p:--><tr bgcolor="#cccccc"><td valign=top width=200><a name="POST8482"><font face="Verdana" size="1"><b><!--email--><!--/email--><!--name-->Analyzer<!--/name--></b></a><br>Username: <!--field:uname-->Analyzer<!--/field--><br><br>Registered: <!--field:registered-->12-2004<!--/field--><br><!--field:ip_address--><!--/field--></font></font></td><td valign=top><font face="Verdana" size="1"><table width=100% border=0 cellspacing=0 cellpadding=0><tr><td align=left><font face="Verdana" size="1">Posted on Wednesday, February 23, 2005 - 7:53 am: &nbsp;&nbsp;</font></td><td align=right></td></tr></table><hr noshade size=0><!--Text-->Maybe this will help <BR> <BR><a href="http://img.photobucket.com/albums/v622/JMTTS/Wichita21.jpg" target=_top>http://img.photobucket.com/albums/v622/JMTTS/Wichi ta21.jpg</a> <BR> <BR><!--/Text--></td></tr>
