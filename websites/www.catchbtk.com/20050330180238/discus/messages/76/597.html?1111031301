<!--p:--><tr bgcolor="#f7f7f7"><td valign=top width=200><a name="POST9245"><font face="Verdana" size="1"><b><!--email--><!--/email--><!--name-->Bodycheck<!--/name--></b></a><br>Username: <!--field:uname-->Bodycheck<!--/field--><br><br>Registered: <!--field:registered-->12-2004<!--/field--><br><!--field:ip_address--><!--/field--></font></font></td><td valign=top><font face="Verdana" size="1"><table width=100% border=0 cellspacing=0 cellpadding=0><tr><td align=left><font face="Verdana" size="1">Posted on Saturday, February 26, 2005 - 11:08 am: &nbsp;&nbsp;</font></td><td align=right></td></tr></table><hr noshade size=0><!--Text-->wow <BR> <BR>didnt see that coming <BR><a href="http://www.foxnews.com/story/0%2C2933%2C148825%2C00.html" target=_top>http://www.foxnews.com/story/0,2933,148825,00.html</a><!--/Text--></td></tr>
