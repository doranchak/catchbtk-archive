<!--p:--><tr bgcolor="#f7f7f7"><td valign=top width=200><a name="POST8731"><font face="Verdana" size="1"><b><!--email--><!--/email--><!--name-->Bestbud<!--/name--></b></a><br>Username: <!--field:uname-->Bestbud<!--/field--><br><br>Registered: <!--field:registered-->12-2004<!--/field--><br><!--field:ip_address--><!--/field--></font></font></td><td valign=top><font face="Verdana" size="1"><table width=100% border=0 cellspacing=0 cellpadding=0><tr><td align=left><font face="Verdana" size="1">Posted on Thursday, February 24, 2005 - 6:48 pm: &nbsp;&nbsp;</font></td><td align=right></td></tr></table><hr noshade size=0><!--Text-->Officer Gary Caldwell: <BR> <BR><a href="http://www.morningsun.net/stories/022702/kan_0227020043.shtml" target=_top>http://www.morningsun.net/stories/022702/kan_02270 20043.shtml</a><!--/Text--></td></tr>
