<!--p:--><tr bgcolor="#cccccc"><td valign=top width=200><a name="POST3126"><font face="Verdana" size="1"><b><!--email--><!--/email--><!--name-->Q<!--/name--></b></a><br>Username: <!--field:uname-->Q<!--/field--><br><br>Registered: <!--field:registered-->12-2004<!--/field--><br><!--field:ip_address--><!--/field--></font></font></td><td valign=top><font face="Verdana" size="1"><table width=100% border=0 cellspacing=0 cellpadding=0><tr><td align=left><font face="Verdana" size="1">Posted on Thursday, December 30, 2004 - 9:53 pm: &nbsp;&nbsp;</font></td><td align=right></td></tr></table><hr noshade size=0><!--Text-->Here is the link to the other site I mentioned above: <BR> <BR><a href="http://www.christianityoasis.com/PurityPublications/5003/BTK/Home.htm" target=_top>http://www.christianityoasis.com/PurityPublication s/5003/BTK/Home.htm</a><!--/Text--></td></tr>
