<!--p:--><tr bgcolor="#f7f7f7"><td valign=top width=200><a name="POST1976"><font face="Verdana" size="1"><b><!--email--><!--/email--><!--name-->Teardrop<!--/name--></b></a><br>Username: <!--field:uname-->Teardrop<!--/field--><br><br>Registered: <!--field:registered-->7-2004<!--/field--><br><!--field:ip_address--><!--/field--></font></font></td><td valign=top><font face="Verdana" size="1"><table width=100% border=0 cellspacing=0 cellpadding=0><tr><td align=left><font face="Verdana" size="1">Posted on Thursday, December 16, 2004 - 9:21 am: &nbsp;&nbsp;</font></td><td align=right></td></tr></table><hr noshade size=0><!--Text-->Here is an article with a bit of autopsy info. No smoke in lungs. <BR><a href="http://www.msnbc.msn.com/id/6723054/" target=_top>http://www.msnbc.msn.com/id/6723054/</a><!--/Text--></td></tr>
