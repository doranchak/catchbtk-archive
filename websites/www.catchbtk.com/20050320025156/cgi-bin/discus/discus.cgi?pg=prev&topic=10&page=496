<!--Post: 7687--><!--Time: 1108656689-->
<!--p:--><tr bgcolor="#f7f7f7"><td valign=top width=200><a name="POST7687"><font face="Verdana" size="1"><b><!--email--><!--/email--><!--name-->Kansasgirl<!--/name--></b></a><br>Username: <!--field:uname-->Kansasgirl<!--/field--><br><br>Registered: <!--field:registered-->2-2005<!--/field--><br><!--field:ip_address--><!--/field--></font></font></td><td valign=top><font face="Verdana" size="1"><table width=100% border=0 cellspacing=0 cellpadding=0><tr><td align=left><font face="Verdana" size="1">Posted on Thursday, February 17, 2005 - 8:11 am: &nbsp;&nbsp;</font></td><td align=right></td></tr></table><hr noshade size=0><!--Text-->Landwehr had a media briefing this morning. It sounded as though LE was trying to speak directly to BTK. LE said that FBI has authenticated the Murdock Park Package and the UPS Package.<!--/Text--></td></tr>
<!--/Post: 7687-->
<!--Post: 7706--><!--Time: 1108659914-->
<!--p:--><tr bgcolor="#cccccc"><td valign=top width=200><a name="POST7706"><font face="Verdana" size="1"><b><!--email--><!--/email--><!--name-->Hmmm<!--/name--></b></a><br>Username: <!--field:uname-->Hmmm<!--/field--><br><br>Registered: <!--field:registered-->7-2004<!--/field--><br><!--field:ip_address--><!--/field--></font></font></td><td valign=top><font face="Verdana" size="1"><table width=100% border=0 cellspacing=0 cellpadding=0><tr><td align=left><font face="Verdana" size="1">Posted on Thursday, February 17, 2005 - 9:05 am: &nbsp;&nbsp;</font></td><td align=right></td></tr></table><hr noshade size=0><!--Text-->c4 and c9....could that be communication instead of chapter?<!--/Text--></td></tr>
