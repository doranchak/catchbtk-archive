<!--p:--><tr bgcolor="#f7f7f7"><td valign=top width=200><a name="POST7727"><font face="Verdana" size="1"><b><!--email--><!--/email--><!--name-->Kansasgirl<!--/name--></b></a><br>Username: <!--field:uname-->Kansasgirl<!--/field--><br><br>Registered: <!--field:registered-->2-2005<!--/field--><br><!--field:ip_address--><!--/field--></font></font></td><td valign=top><font face="Verdana" size="1"><table width=100% border=0 cellspacing=0 cellpadding=0><tr><td align=left><font face="Verdana" size="1">Posted on Thursday, February 17, 2005 - 11:00 am: &nbsp;&nbsp;</font></td><td align=right></td></tr></table><hr noshade size=0><!--Text-->Here is the link. <BR> <BR><a href="http://www.kake.com/home/headlines/1274602.html" target=_top>http://www.kake.com/home/headlines/1274602.html</a><!--/Text--></td></tr>
